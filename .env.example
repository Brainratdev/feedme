# ===== WAJIB =====
# Contract address $FEEDME (mint dari pump.fun, biasanya berakhiran "pump")
MINT=

# Private key wallet CREATOR (wallet yang dipakai untuk launch koin di pump.fun).
# Bisa format base58 (hasil "Export Private Key" dari Phantom) atau array JSON [12,34,...].
# JANGAN pernah commit/bagikan file .env ini.
PRIVATE_KEY=
# Atau pakai file keypair (solana-keygen), lalu kosongkan PRIVATE_KEY:
# KEYPAIR_PATH=/path/ke/keypair.json

# ===== WEBSITE (opsional) =====
# Link X yang tampil di website.
X_URL=https://x.com/feedmelana
# URL publik website, untuk gambar preview di X. Di Railway terisi otomatis.
# SITE_URL=https://feedme.xyz

# ===== RPC =====
# RPC publik gampang kena limit. Pakai RPC pribadi (Helius, QuickNode, Triton, dll).
RPC_URL=https://api.mainnet-beta.solana.com

# ===== PENGATURAN SUAPAN =====
# true = simulasi saja (aman untuk tes). Ganti ke false kalau sudah yakin.
DRY_RUN=true
# Cek & suapi setiap berapa menit
INTERVAL_MINUTES=60
# Jangan suapi kalau total yang bisa disuapkan kurang dari ini (SOL)
MIN_FEED_SOL=0.1
# Batas maksimal per ronde, supaya pembelian tidak menggerakkan harga terlalu jauh (SOL)
MAX_FEED_SOL=2
# SOL yang selalu disisakan di wallet untuk biaya transaksi
RESERVE_SOL=0.03
# Slippage dalam persen (2 = 2%)
SLIPPAGE_PCT=2
# Priority fee (micro-lamports per compute unit). Naikkan kalau jaringan sedang ramai.
PRIORITY_FEE_MICROLAMPORTS=50000

# Lokal: log suapan otomatis ditulis ke feedme/feedings.json.
# Di Railway: DATA_DIR=/data (Volume), feedings.json & state bot disimpan di sana.
# DATA_DIR=
