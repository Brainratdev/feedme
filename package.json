{
  "name": "feedme",
  "version": "1.0.0",
  "description": "$FEEDME: the Gob website plus the bot that feeds every creator fee back into the PumpSwap pool",
  "scripts": {
    "start": "node server.js",
    "bot": "node feedme-bot/bot.js",
    "bot:once": "node feedme-bot/bot.js --once",
    "bot:check": "DRY_RUN=true node feedme-bot/bot.js --once",
    "video": "node video/render.mjs",
    "preflight": "node scripts/preflight.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "type": "module",
  "dependencies": {
    "@pump-fun/pump-sdk": "2.0.0",
    "@pump-fun/pump-swap-sdk": "1.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.3"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "mp4-muxer": "^5.2.2"
  }
}
